{
  "buildCommand": "cd client && npm install --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/health",              "destination": "/api/index" },
    { "source": "/auth/:path*",         "destination": "/api/index" },
    { "source": "/activities",          "destination": "/api/index" },
    { "source": "/activities/:path*",   "destination": "/api/index" },
    { "source": "/athlete/:path*",      "destination": "/api/index" },
    { "source": "/(.*)",                "destination": "/index.html" }
  ]
}
